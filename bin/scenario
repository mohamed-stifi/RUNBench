#!/usr/bin/env bash
# RUNBench scenario CLI (Issues #01 + #02).
# Delegates validation to schemas/validate.py under the uv-managed .venv.
set -euo pipefail

usage() {
  echo "usage: scenario validate <scenario-file>" >&2
  exit 2
}

ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
PY="$ROOT/.venv/bin/python"

[[ "${1:-}" == "validate" && -n "${2:-}" ]] || usage
[[ -x "$PY" ]] || {
  echo "scenario validate: missing .venv python — run: uv venv .venv && uv pip install -r requirements.txt" >&2
  exit 1
}
exec "$PY" "$ROOT/schemas/validate.py" "$2"
